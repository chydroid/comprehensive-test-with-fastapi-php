# 复制为 .env 后按需修改
APP_DEBUG=false

# 数据库（本项目复用 csip_exam 库表结构）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=csip_exam
DB_USER=csip_exam
DB_PASS=请填写数据库密码
DB_PERSISTENT=true
# 读写分离：只读库（纯 SELECT 走只读，其余走主库）；enabled=true 且 host 非空才生效
DB_READ_ENABLED=false
DB_READ_HOST=
DB_READ_PORT=3306
DB_READ_NAME=
DB_READ_USER=
DB_READ_PASS=
DB_READ_PERSISTENT=true
# 连接池：主要用于 Swoole 常驻进程；PHP-FPM 用持久连接即可，通常关闭
DB_POOL_ENABLED=false
DB_POOL_SIZE=8

# 会话 Cookie：生产启用 HTTPS 后置为 true
SESSION_SECURE=false

# 限流
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=120
# 驱动：redis（需 phpredis 扩展 + Redis 服务）| file（默认，零依赖）
RATE_LIMIT_DRIVER=file

# Redis（可选；用于限流/缓存的原子跨进程存储）
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=2.0

# Memcached（可选；优先级低于 Redis）
MEMCACHED_ENABLED=false
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# APCu（可选；CLI 需 apcu.enable_cli=1）
APCU_ENABLED=false

# Array（单请求内存缓存，零依赖）
ARRAY_CACHE_ENABLED=false

# 日志级别：debug < info < warning < error < critical
LOG_LEVEL=info
# 慢请求告警阈值（毫秒）
LOG_SLOW_MS=1000

# 上传与请求体上限（字节）
UPLOAD_MAX_BYTES=2097152
MAX_BODY_BYTES=2097152
